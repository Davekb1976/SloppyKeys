# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Logs (log.prev.txt is the rotated log — `*.log` does not match it)
*.log
log.txt
log.prev.txt

# User secrets & local state (private server link, Discord webhook URL)
/settings.json



# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.sw?

# Scratch client dumps, not templates: `assets/debug/` and the challenge panel's
# `assets/challenge/debug/`. They are screenshots of the user's own game, they are
# overwritten on every scan, and `build_exe.py` already refuses to ship them.
/assets/debug/
assets/**/debug/

# Saved crops of the user's own OCR boxes, shown as previews in Settings > OCR. Rewritten
# on every Preview/Test and specific to their calibration, so there is nothing to ship.
/assets/regions/

# The user's own walk recordings. `paths/defaults/` is the exception: those are the walk
# paths Auto looks up by name (`content/walk_paths.py`), shared game data rather than
# anyone's recording — without them Auto does nothing on a fresh clone.
/paths/*
!/paths/defaults/

# The rest of the user's work, for the same reason and named in `build_exe.py`'s own comment
# about what a shipped build deliberately has none of: saved block macros, input recordings,
# and the Detect block's capture folder (its Capture button writes there, and the crops are
# of whatever was on that user's screen).
/operations/
/recordings/
/assets/detect/

# Multi-root editor workspace: it points at sibling folders that only exist on one
# machine (`../Anime-Expeditions-Creams-Macro-main`, `../../SLOPPYKEYS`), so committing it
# hands the next clone a broken workspace.
/SloppyKeys.code-workspace

# PyInstaller output (see build_exe.py). The runnable folder is built, never committed.
/build/
/dist/
/installer_output/
crash.txt
